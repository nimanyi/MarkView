{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认权限：核心 API + 文件对话框 + 窗口标题 + 更新/重启 + 外链打开",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-title",
    "updater:default",
    "process:default",
    "opener:default"
  ]
}
